{
  "manifest_version": 3,
  "name": "BulkAI ChatGPT Bridge",
  "version": "1.1.3",
  "description": "Bridge between BulkAI PC App and ChatGPT Web for automated prompt/response extraction",
  "permissions": ["activeTab", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://labs.google/*",
    "https://flow.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://labs.google/*", "https://flow.google.com/*"],
      "js": ["content_flow.js"],
      "run_at": "document_idle"
    }
  ]
}